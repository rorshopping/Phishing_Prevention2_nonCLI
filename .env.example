# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db
# DATABASE_URL=postgresql+asyncpg://phishguard:phishguard@localhost:5432/phishguard

# Gophish
GOPHISH_API_URL=https://127.0.0.1:3333/api
GOPHISH_API_KEY=your_gophish_api_key

# AI / LLM (OpenAI-compatible or OpenRouter)
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# SMTP (Gmail — overrides Gophish SMTP config)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
GMAIL_FROM=your_email@gmail.com

# Email Delivery (Amazon SES — alternative to Gmail SMTP)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
EMAIL_SOURCE=simulation@yourdomain.com

# Twilio (Vishing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+491234567890

# Web Search (personalization)
SERPAPI_API_KEY=your_serpapi_key

# App
GDPR_HASH_SALT=generate-a-random-64-char-hex-string
LOG_LEVEL=INFO
